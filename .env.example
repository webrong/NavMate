APP_NAME=NavMate
# 生产环境必须设为 production（local 会跳过安装锁/维护检查/CSP 三重防护）
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# 内容安全策略开关（留空 = 仅 local 环境自动关闭）
# CSP_DISABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# 安装向导 / 命令行安装（InstallerService / db:seed）
# ---------------------------------------------------------------------------
# WEB 安装向导测试数据库连接时自动建库使用的连接前缀
# NAV_DB_HOST=127.0.0.1
# NAV_DB_PORT=3306
# NAV_DB_DATABASE=navigation
# NAV_DB_USERNAME=root
# NAV_DB_PASSWORD=
# CLI 安装（php artisan navmate:install）的管理员账号
# ADMIN_DEFAULT_EMAIL=admin@example.com
# ADMIN_DEFAULT_PASSWORD=
# db:seed 创建默认管理员（username=admin）时使用；留空则生成随机密码并打印
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Update source (leave empty to disable auto-update)
# 在线升级源：默认指向官方仓库 webrong/NavMate，开箱即用，无需修改。
# 仅当你 fork 本项目用于自测时，才取消注释并改成你自己的仓库地址。
# UPDATE_GITHUB_REPO=your-fork/NavMate
# UPDATE_CUSTOM_SOURCE=https://example.com/version.json
